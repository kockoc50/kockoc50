{
  "name": "claude-for-word",
  "version": "1.0.0",
  "description": "Connect Claude AI to Microsoft Word as an Office Add-in",
  "scripts": {
    "start": "office-addin-debugging start manifest.xml",
    "stop": "office-addin-debugging stop manifest.xml",
    "dev-server": "npx http-server . -p 3000 --ssl --cert certs/localhost.crt --key certs/localhost.key",
    "serve": "npx http-server . -p 3000",
    "validate": "office-addin-manifest validate manifest.xml",
    "sideload": "office-addin-debugging start manifest.xml desktop"
  },
  "devDependencies": {
    "office-addin-debugging": "^5.1.12",
    "office-addin-dev-certs": "^1.12.1",
    "office-addin-manifest": "^1.13.5",
    "http-server": "^14.1.1"
  },
  "keywords": ["word", "office", "addin", "claude", "anthropic", "ai"],
  "license": "MIT"
}
